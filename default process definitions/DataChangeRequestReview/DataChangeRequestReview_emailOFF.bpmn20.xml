  <process id="dataChangeRequestReview" name="Data Change Request Review" isExecutable="true">
    <startEvent id="startevent1" name="Start">
      <extensionElements>
        <activiti:executionListener class="com.reltio.workflow.activiti.service.DCRHasChangesListener" event="start" />
      </extensionElements>
    </startEvent>
    <userTask id="dcrReview" name="DCR Review" activiti:dueDate="P2D" activiti:candidateGroups="ROLE_REVIEWER">
      <extensionElements>
        <activiti:formProperty id="decision" name="Decision" type="enum" default="Approve" required="true">
          <activiti:value id="Approve" name="Approve"></activiti:value>
          <activiti:value id="Reject" name="Reject"></activiti:value>
        </activiti:formProperty>
        <activiti:formProperty id="accessTypes" name="AccessTypes" type="string" default="ACCEPT_CHANGE_REQUEST" writable="false"></activiti:formProperty>
        <activiti:formProperty id="validator" name="Validator" type="string" default="com.reltio.workflow.core.task.validator.DataChangeRequestValidator" writable="false"></activiti:formProperty>
        <activiti:formProperty id="notificationOnAssignmentEnabled" name="NotificationOnAssignmentEnabled" type="boolean" default="false" writable="false"></activiti:formProperty>
        <activiti:formProperty id="notificationOnCompletionEnabled" name="NotificationOnCompletionEnabled" type="boolean" default="false" writable="false"></activiti:formProperty>
        <activiti:taskListener event="create" class="com.reltio.workflow.activiti.service.TaskStartEventListener"></activiti:taskListener>
        <activiti:taskListener event="create" class="com.reltio.workflow.activiti.service.DCRTypeTaskListener"></activiti:taskListener>
        <activiti:taskListener event="assignment" class="com.reltio.workflow.activiti.service.TaskAssignmentEventListener"></activiti:taskListener>
      </extensionElements>
    </userTask>
    <sequenceFlow id="flow1" sourceRef="startevent1" targetRef="dcrReview"></sequenceFlow>
    <exclusiveGateway id="exclusivegateway1" name="Exclusive Gateway"></exclusiveGateway>
    <sequenceFlow id="flow2" sourceRef="dcrReview" targetRef="exclusivegateway1"></sequenceFlow>
    <serviceTask id="ApproveService" name="Approve Service" activiti:class="com.reltio.workflow.activiti.service.ChangeRequestApply"></serviceTask>
    <sequenceFlow id="Approve" name="Approve" sourceRef="exclusivegateway1" targetRef="ApproveService">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision=='Approve'}]]></conditionExpression>
    </sequenceFlow>
    <serviceTask id="RejectService" name="Reject Service" activiti:class="com.reltio.workflow.activiti.service.ChangeRequestReject"></serviceTask>
    <sequenceFlow id="Reject" name="Reject" sourceRef="exclusivegateway1" targetRef="RejectService">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision=='Reject'}]]></conditionExpression>
    </sequenceFlow>
    <endEvent id="endevent1" name="End"></endEvent>
    <sequenceFlow id="flow5" sourceRef="ApproveService" targetRef="endevent1"></sequenceFlow>
    <sequenceFlow id="flow6" sourceRef="RejectService" targetRef="endevent1"></sequenceFlow>
    <dataObject id="manualStart" name="manualStart" itemSubjectRef="xsd:boolean">
      <extensionElements>
        <activiti:value>false</activiti:value>
      </extensionElements>
    </dataObject>
    <dataObject id="deleted" name="deleted" itemSubjectRef="xsd:boolean">
      <extensionElements>
        <activiti:value>false</activiti:value>
      </extensionElements>
    </dataObject>
  </process>
